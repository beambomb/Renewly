# Copy to .env.local and fill in. Never commit real values.

# Public (shipped to the browser, safe by design)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Web Push public key (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server-only. Do not prefix with NEXT_PUBLIC_.
# Shared secret for the manual reminder-trigger route (generate a long random string)
REMINDER_TRIGGER_SECRET=

# Supabase Edge Function secrets are set with `supabase secrets set`, not in this file:
#   RESEND_API_KEY, RESEND_FROM, VAPID_PRIVATE_KEY, VAPID_SUBJECT

# Used only by `npm run test:rls` against a throwaway dev project (never production)
SUPABASE_DB_URL=
